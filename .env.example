# App DB — banco de estado da aplicação web (perfis de conexão, jobs, histórico).
# Não confundir com os bancos MySQL de origem/destino que a ferramenta migra —
# esses são informados por ConnectionProfile em tempo de execução, não aqui.
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_USER=root
APP_DB_PASSWORD=
APP_DB_NAME=app_migracao

# Chave de cifragem do cofre de credenciais (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_VAULT_KEY=

# Porta HTTP da aplicação.
PORT=3000
